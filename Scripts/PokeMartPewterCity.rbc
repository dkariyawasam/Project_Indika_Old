//---------------
#dynamic 0x740000
#org @PokeMartPewterCity
lock
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
checkflag 0x231
if 0x1 goto @VitaminsAdded
pokemart @MRTPewter
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end

//-----------------------------------------------------------------------
#org @VitaminsAdded
pokemart @MRTPewterThunder
release


//---------
// Strings
//---------
