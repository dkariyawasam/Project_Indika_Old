//---------------
#dynamic 0x740000
#org @PokeMartPalletTown
lock
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
pokemart @MRTPalletTown
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end


//---------
// Strings
//---------
#org @MSGGreeting
= Hi, there!\nMay I help you?

#org @MSGGoodbye
= Please come again!

//-----------
// MartItems
//-----------
#org @MRTPalletTown
#raw word 0xCD
#raw word 0xD9
#raw word 0x5D
#raw word 0x50
#raw word 0x4
#raw word 0xD
#raw word 0x56
#raw word 0x0