//---------------
#dynamic 0x740000
#org @MistyPowerPlant
compare 0x4033 0x0
if 0x1 goto @Greeting
end

#org @Greeting
lockall
msgbox @MSGGreeting MSG_KEEPOPEN
applymovement 0xF @MOVE1
waitmovement 0xF
msgbox @MSGGreeting2 MSG_KEEPOPEN
applymovement 0xF @MOVE2
waitmovement 0xF
setflag 0x202
setvar 0x4012 0x2
setvar 0x4032 0x1
hidesprite 0xF
releaseall
end

//---------
// Strings
//---------
#org @MSGGreeting
= Fuhaha, There it is!\nIt's the fossil I was looking for!

#org @MSGGreeting2
= Uh? Are you a gym challenger?\nI'm not one to neglect my duties.\pI'll meet you at the gym.

//-----------
// Movements
//-----------
#org @MOVE1
#raw 0x62 //Exclamation Mark (!)
#raw 0x0 //Face Down
#raw 0xFE //End of Movements

#org @MOVE2
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0x10 //Step Down (Normal)
#raw 0xFE //End of Movements