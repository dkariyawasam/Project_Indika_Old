//---------------
#dynamic 0x740000
#org @PokeMartViridianCity
lock
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
checkflag 0x231
if 0x1 goto @VitaminsAdded
pokemart @MRTViridian
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end

//-----------------------------------------------------------------------
#org @VitaminsAdded
pokemart @MRTViridianThunder
release


