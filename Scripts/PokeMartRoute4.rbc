//---------------
#dynamic 0x740000
#org @PokeMartRoute4
lock
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
pokemart @MRTRoute4
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end


//---------
// Strings
//---------
#org @MSGGreeting
= Hi, there!\nMay I help you?

#org @MSGGoodbye
= Please come again!

//-----------
// MartItems
//-----------
#org @MRTRoute4
#raw word 0x4
#raw word 0x1E
#raw word 0x1F
#raw word 0x20
#raw word 0x21
#raw word 0x56
#raw word 0x53
#raw word 0x54
#raw word 0x55
#raw word 0x0