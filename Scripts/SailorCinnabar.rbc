//---------------
#dynamic 0x740000
#org @SailorCinnabar
lock
faceplayer
msgbox @MSGPalletSeafoam MSG_KEEPOPEN //"Ahoy, there!\pI can take you to\nP..."
multichoice 0x0 0x0 0x2C 0x1
compare LASTRESULT 0x0
if 0x1 goto 0x874312D
compare LASTRESULT 0x1
if 0x1 goto 0x8743142
compare LASTRESULT 0x2
if 0x1 goto 0x8743157
release
end

//---------------
#org 0x74312D
msgbox 0x87431AA MSG_KEEPOPEN //"Okay, everything's in order.\pWe'l..."
closeonkeypress
fadescreen 0x1
setvar 0x8006 0x1
special 0x17B
waitstate
end

//---------------
#org 0x743142
msgbox 0x87431AA MSG_KEEPOPEN //"Okay, everything's in order.\pWe'l..."
closeonkeypress
fadescreen 0x1
setvar 0x8006 0x3
special 0x17B
waitstate
end

//---------------
#org 0x743157
msgbox 0x87431E7 MSG_NORMAL //"Alright, do come talk to me\nwhen ..."
release
end


//---------
// Strings
//---------
#org @MSGPalletSeafoam
= Ahoy, there!\pI can take you to\nPALLET TOWN or SEAFOAM ISLANDS.\pShall we go?

#org 0x7431AA
= Okay, everything's in order.\pWe'll be departing immediately.

#org 0x7431E7
= Alright, do come talk to me\nwhen you do.