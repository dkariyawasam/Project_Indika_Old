//---------------
#dynamic 0x740000

#org @CinnabarLabGymLocked
lockall
textcolor 0x3
applymovement MOVE_PLAYER @MOVELookAt
waitmovement 0x0
pause 0x14
msgbox @MSGNotice MSG_KEEPOPEN
closeonkeypress
applymovement MOVE_PLAYER @MOVEAway
waitmovement 0x0
releaseall
end


//---------
// Strings
//---------
#org @MSGNotice
= The doors are locked. A GYM BADGE\nis required to enter.


//-----------
// Movements
//-----------
#org @MOVELookAt
#raw 0x2E
#raw 0xFE //End of Movements

#org @MOVEAway
#raw 0x10
#raw 0xFE //End of Movements