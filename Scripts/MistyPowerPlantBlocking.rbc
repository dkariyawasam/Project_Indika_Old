//---------------
#dynamic 0x740000
#org @MistyPowerPlant
compare 0x4033 0x0
if 0x1 goto @Greeting
end

#org @Greeting
lockall
applymovement 0x9 @MOVE1
waitmovement 0x9
msgbox @MSGGreeting MSG_KEEPOPEN
applymovement 0x9 @MOVE2
waitmovement 0x9
setflag 0x204
setvar 0x4013 0x2
setvar 0x4033 0x1
hidesprite 0x9
releaseall
end

//---------
// Strings
//---------
#org @MSGGreeting
= Not sure why you're here, but I've\njust turned the power back on so\lthere's no need to look into it\lfurther, umphf!\pI need to get back to the GYM.\p[.]I guess things are ever-changing\nas always.

//-----------
// Movements
//-----------
#org @MOVE1
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x62 //Exclamation Mark (!)
#raw 0xFE //End of Movements

#org @MOVE2
#raw 0x11 //Step Up (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x11 //Step Up (Normal)
#raw 0x11 //Step Up (Normal)
#raw 0x11 //Step Up (Normal)
#raw 0x11 //Step Up (Normal)
#raw 0xFE //End of Movements