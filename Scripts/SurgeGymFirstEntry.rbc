//---------------
#dynamic 0x740000
#org @GymSurgeFirstEntry
lockall
applymovement 0x4 @MoveGymAide
waitmovement 0x4
msgbox @MSGGreeting MSG_KEEPOPEN
applymovement 0x4 @MoveGymAide2
waitmovement 0x4
releaseall
setvar 0x4013 0x1
end


//---------
// Strings
//---------
#org @MSGGreeting
= [blue_fr]Welcome to VERMILION CITY GYM!\nSurge went off to train.\pGo check for yourself, he's in\nDIGLETT CAVE just east from here. 


//-----------
// Movements
//-----------
#org @MoveGymAide
#raw 0x62 //Exclamation Mark (!)
#raw 0x13 //Step Right (Normal)
#raw 0x0 //Face Down
#raw 0xFE //End of Movements

#org @MoveGymAide2
#raw 0x12 //Step Left (Normal)
#raw 0x0 //Face Down
#raw 0xFE //End of Movements