//---------------
#dynamic 0x740000
#org @PokeMartCeladonCity
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
checkflag 0x231
pokemart @MRTCeladon
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end

//-----------------------------------------------------------------------

//---------
// Strings
//---------
#org @MSGGreeting
= Hi, there!\nMay I help you?

#org @MSGGoodbye
= Please come again!

//-----------
// MartItems
//-----------
#org @MRTCeladon
#raw word 0x62
#raw word 0x61
#raw word 0x5F
#raw word 0x60
#raw word 0x5D
#raw word 0x0