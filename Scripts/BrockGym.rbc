//---------------
#dynamic 0x740000

#org @brock
setvar 0x8004 0x2
setvar 0x8005 0x2
special 0x174
checkflag 0x254                                                                     //Check if TM acquired
if 0x0 goto @battlesorter                                                           //If not, go to battle sorter

goto 0x16B5D7
release
end


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org @battlesorter                                                                  //battle sorter using var 4011 to count number of badges acquired
compare 0x4011 0x0                                                                  //if 0, trigger battle1
if 0x1 goto @battle1

compare 0x4011 0x1                                                                  //if 1, trigger battle2
if 0x1 goto @battle2

compare 0x4011 0x2                                                                  //if 2, trigger battle3
if 0x1 goto @battle3

compare 0x4011 0x3                                                                  //if 3, trigger battle4
if 0x1 goto @battle4

compare 0x4011 0x4                                                                  //if 4, trigger battle5
if 0x1 goto @battle5

compare 0x4011 0x5                                                                  //if 5, trigger battle6
if 0x1 goto @battle6

compare 0x4011 0x6                                                                  //if 6, trigger battle7
if 0x1 goto @battle7
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org @battle1                                                                       //brock gym challenge 1
trainerbattle 0x1 0x19E 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle2                                                                       //brock gym challenge 2
trainerbattle 0x1 0x0 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle3                                                                       //brock gym challenge 3
trainerbattle 0x1 0x1 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle4                                                                       //brock gym challenge 4
trainerbattle 0x1 0x2 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle5                                                                       //brock gym challenge 5
trainerbattle 0x1 0x3 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle6                                                                       //brock gym challenge 6
trainerbattle 0x1 0x4 0x0 @msggreeting @msgdefeated @afterbattle
return

#org @battle7                                                                       //brock gym challenge 7
trainerbattle 0x1 0x5 0x0 @msggreeting @msgdefeated @afterbattle
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org @afterbattle                                                                   //after battle
setvar 0x8004 0x2
setvar 0x8005 0x1
special 0x173
setflag 0x4B0                                                                       //Gym aide recognises you beat Brock
setflag 0x820                                                                       //Player has the boulderbadge
setvar 0x406C 0x1                                                                   //Disables man that traps you in pewter until you beat Brock
setflag 0x2E
clearflag 0x92
setvar 0x8008 0x1
call 0x1A6B18
message @msgtm 0x4
message @msgtm2 0x4
setflag 0x254                                                                       //TM acquired
addvar 0x4011 0x1
message @msgtm3 0x6
end


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x16B5D7                                                                       //Trade
lock
faceplayer
setvar 0x8008 0x3
call 0x81A8CAD
checkflag 0x24D                                                                     //Check if traded already
if 0x1 goto 0x816B649
msgbox @MSGTrade MSG_YESNO
compare LASTRESULT 0x0
if 0x1 goto 0x816B631
call 0x81A8CBD
compare 0x8004 0x6
if 0x4 goto 0x816B631
call 0x81A8CC9
comparevars LASTRESULT 0x8009
if 0x5 goto 0x816B63B
call 0x81A8CD9
msgbox @MSGTradeComplete MSG_KEEPOPEN //"Thank you!"
setflag 0x24D
release
end

//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x1A8CAD
copyvar 0x8004 0x8008
special2 LASTRESULT 0xFC
copyvar 0x8009 LASTRESULT
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x16B649
msgbox 0x8194A4F MSG_KEEPOPEN //"How is my old [buffer2]?\pMy [buff..."
release
end


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x16B631
msgbox 0x81949FD MSG_KEEPOPEN //"That's too bad."
release
end


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x1A8CBD
special 0x9F
waitstate
lock
faceplayer
copyvar 0x800A 0x8004
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x1A8CC9
copyvar 0x8005 0x800A
special2 LASTRESULT 0xFF
copyvar 0x800B LASTRESULT
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x16B63B
bufferpokemon 0x0 0x8009
msgbox 0x8194A0D MSG_KEEPOPEN //"[.]This is no [buffer1].\pIf you g..."
release
end


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x1A8CD9
copyvar 0x8004 0x8008
copyvar 0x8005 0x800A
special 0xFD
special 0xFE
waitstate
lock
faceplayer
return


//---------------------------------------------------------------------------------------------------------------------------------------------------
#org 0x1A6B18
copyvar 0x8000 0x8008
compare 0x8000 0x1
if 0x1 goto 0x81A6B76
compare 0x8000 0x2
if 0x1 goto 0x81A6B7A
compare 0x8000 0x3
if 0x1 goto 0x81A6B81
compare 0x8000 0x4
if 0x1 goto 0x81A6B8B
compare 0x8000 0x5
if 0x1 goto 0x81A6BA1
compare 0x8000 0x6
if 0x1 goto 0x81A6BB4
compare 0x8000 0x7
if 0x1 goto 0x81A6BCA
compare 0x8000 0x8
if 0x1 goto 0x81A6BE0
end


#org 0x1A6B76
cleartrainerflag 0x8E
return


#org 0x1A6B7A
cleartrainerflag 0x96
cleartrainerflag 0xEA
return


#org 0x1A6B81
cleartrainerflag 0x8D
cleartrainerflag 0xDC
cleartrainerflag 0x1A7
return


#org 0x1A6B8B
cleartrainerflag 0x84
cleartrainerflag 0x85
cleartrainerflag 0xA0
cleartrainerflag 0x109
cleartrainerflag 0x10A
cleartrainerflag 0x10B
cleartrainerflag 0x192
return


#org 0x1A6BA1
cleartrainerflag 0x126
cleartrainerflag 0x127
cleartrainerflag 0x120
cleartrainerflag 0x121
cleartrainerflag 0x124
cleartrainerflag 0x125
return


#org 0x1A6BB4
cleartrainerflag 0x118
cleartrainerflag 0x119
cleartrainerflag 0x11A
cleartrainerflag 0x11B
cleartrainerflag 0x1CE
cleartrainerflag 0x1CF
cleartrainerflag 0x1D0
return


#org 0x1A6BCA
cleartrainerflag 0xB1
cleartrainerflag 0xB2
cleartrainerflag 0xB3
cleartrainerflag 0xB4
cleartrainerflag 0xD5
cleartrainerflag 0xD6
cleartrainerflag 0xD7
return


#org 0x1A6BE0
cleartrainerflag 0x128
cleartrainerflag 0x129
cleartrainerflag 0x142
cleartrainerflag 0x143
cleartrainerflag 0x144
cleartrainerflag 0x188
cleartrainerflag 0x190
cleartrainerflag 0x191
return


'---------
' Strings
'---------
#org @msggreeting
= So, you're here. I'm BROCK.\nI'm PEWTER's GYM LEADER.\pMy rock-hard willpower is evident\neven in my POKÈMON.\pThat's right - my POKÈMON are all\nthe ROCK type!\pFuhaha! But enough talking[.]\nShow me your best!\c\h0B\h56\h01

#org @msgdefeated
= I took you for granted, and so\nI lost.\pAs proof of your victory, I confer\nthe POKÈMON LEAGUE BOULDERBADGE.\p\c\h06¡[player] received the BOULDERBADGE\nfrom BROCK!\c\h17\c\h0B«¿\c\h08\n\c\h08[Ke]\c\h18\p\c\h06«Just having the BOULDERBADGE makes\nyour POKÈMON more powerful.\pIt also grants you access to the\nPOKÈMON LAB in CINNABAR ISLAND.\pIt specialises in reviving POKÈMON\nfrom FOSSILS.\pDo go check it out.

#org @msgtm
= Wait! You weren't here for the\nGYM CHALLENGE?\p[.]\p[.]So you're researching the bonds\nbetween POKÈMON and TRAINERS?\pYou should've said so from the\nstart!

#org @msgtm2
= You see, when I traded one of my\nPOKÈMON for a GRAVELER, something\lunexpected happened!\pThe energy released from the trade\ntriggered something in GRAVELER.\pIt evolved further becoming GOLEM.\pI can trade you a GRAVELER so you\ncan see for yourself!

#org @msgtm3
= It's said that a ROCK type POKÈMON,\nlong thought to have gone extinct,\lstill dwells deep in the seas.\pBring me it and GRAVELER is yours!

#org @MsgTrade
= So!\nDo you have the deep sea POKÈMON?\pWant to trade it for my [buffer2]?

#org @MSGTradeComplete
= There it is!\pThe power of trade brought forth[.]\p[.]GOLEM, the MEGATON POKÈMON!

#org 0x194A4F
= How is my old POKÈMON?\pHope that helped you with your\nresearch!

#org 0x1949FD
= That's too bad.

#org 0x194A0D
= [.]I don't think this is it.