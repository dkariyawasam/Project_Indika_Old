//---------------
#dynamic 0x740000
#org @PokeMartCeladonCity
faceplayer
special 0x187
compare LASTRESULT 0x2
if 0x1 goto @End
preparemsg @MSGGreeting
waitmsg
checkflag 0x231
pokemart @MRTCeladon
msgbox @MSGGoodbye MSG_KEEPOPEN
release
end

//---------------
#org @End
end

//-----------------------------------------------------------------------

//---------
// Strings
//---------
#org @MSGGreeting
= Hi, there!\nMay I help you?

#org @MSGGoodbye
= Please come again!

//-----------
// MartItems
//-----------
#org @MRTCeladon
#raw word 0xB5
#raw word 0xC8
#raw word 0xC4
#raw word 0xBA
#raw word 0xC6
#raw word 0xCD
#raw word 0xD2
#raw word 0xCE
#raw word 0xD4
#raw word 0xD8
#raw word 0x0