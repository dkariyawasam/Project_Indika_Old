//---------------
#dynamic 0x740000
#org @SailorSeafoam
lock
faceplayer
msgbox @MSGGoCinnabarFuchsia MSG_KEEPOPEN
multichoice 0x0 0x0 0x2D 0x1
compare LASTRESULT 0x0
if 0x1 goto @GoCinnabar
compare LASTRESULT 0x1
if 0x1 goto @GoFuchsia
compare LASTRESULT 0x2
if 0x1 goto 0x8743157
release
end

//---------------
#org @GoCinnabar
msgbox 0x87431AA MSG_KEEPOPEN //"Okay, everything's in order.\pWe'l..."
closeonkeypress
fadescreen 0x1
setvar 0x8006 0x8
special 0x17B
waitstate
end

//---------------
#org @GoFuchsia
msgbox 0x87431AA MSG_KEEPOPEN //"Okay, everything's in order.\pWe'l..."
closeonkeypress
fadescreen 0x1
setvar 0x8006 0x2
special 0x17B
waitstate
end

//---------------
#org 0x743157
msgbox 0x87431E7 MSG_NORMAL //"Alright, do come talk to me\nwhen ..."
release
end


//---------
// Strings
//---------
#org @MSGGoCinnabarFuchsia
= Ahoy, there!\pI can take you to\nCINNABAR ISLAND or FUCHSIA CITY.\pShall we go?

#org 0x7431AA
= Okay, everything's in order.\pWe'll be departing immediately.

#org 0x7431E7
= Alright, do come talk to me\nwhen you do.