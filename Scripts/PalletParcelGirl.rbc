//---------------
#dynamic 0x740000
#org @PalletParcelGirl
lockall
applymovement 0x1 @MOVE1
applymovement MOVE_PLAYER @MOVE2
waitmovement 0x0
call @ParcelGiveaway
releaseall
end

//---------------
#org @ParcelGiveaway
textcolor 0x1
msgbox @MSGParcelFound MSG_KEEPOPEN
closeonkeypress
pause 0x14
textcolor 0x3
setflag 0x83E
setvar 0x4070 0x1
setvar 0x4002 0x0
special 0x170
special 0x171
setvar 0x4057 0x1
additem 0x15D 0x1
signmsg
loadpointer 0x0 @MSGReceivedParcel //"[player] received OAK'S PARCEL\nfr..."
giveitem2 0x15D 0x1 0x13E
waitfanfare
setvar 0x4055 0x5
setvar 0x4032 0x0
setvar 0x4033 0x0
setvar 0x4034 0x0
setvar 0x4035 0x0
setvar 0x4036 0x0
setvar 0x4037 0x0
setvar 0x4038 0x0
setvar 0x4039 0x0
normalmsg
textcolor 0x1
msgbox @MSGGoodbye MSG_KEEPOPEN //"Maybe someone dropped it."
return


//---------
// Strings
//---------
#org @MSGParcelFound
= Wait!\nI found this parcel on the ground.\pCan I leave it with you?

#org @MSGReceivedParcel
= [player] received\nOAK'S PARCEL from cheerful girl.

#org @MSGGoodbye
= Maybe someone dropped it.


//-----------
// Movements
//-----------
#org @MOVE1
#raw 0x30 //Face Right (Delayed)
#raw 0xFE //End of Movements

#org @MOVE2
#raw 0x2F //Face Left (Delayed)
#raw 0xFE //End of Movements