//---------------
#dyn 0x740000
#org @GymFirstEntry
#raw word 0x4012
#raw word 0x0
#raw pointer @OnWarp
#raw word 0x0

#org @OnWarp
lock
applymovement 0x3 MOVE1
waitmovement 0x3
msgbox @MSGWelcome MSG_KEEPOPEN //"Welcome to PEWTER'S GYM!\nIf you'r..."
applymovement 0x3 @MOVE2
waitmovement 0x3
setvar 0x4012 0x1
release
end

//-----------
// Strings
//-----------
#org @MSGWelcome
= Welcome to PEWTER'S GYM!\nIf you're looking for GYM LEADER\lBrock, he's away in Mt Moon.\pMight be a while before he's back. 

//-----------
// Movements
//-----------
#org @MOVE1
#raw 0x62 //Exclamation Mark (!)
#raw 0x10 //Step Down (Normal)
#raw 0x12 //Step Left (Normal)
#raw 0x0 //Face Down
#raw 0xFE //End of Movements

#org @MOVE2
#raw 0x11 //Step Up (Normal)
#raw 0x13 //Step Right (Normal)
#raw 0x0 //Face Down
#raw 0xFE //End of Movements

